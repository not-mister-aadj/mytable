# MapKit (optional)
MAPKIT_TEAM_ID=
MAPKIT_KEY_ID=
MAPKIT_PRIVATE_KEY=

# === Localhost: MyTable-dev (Supabase dev project) ===
# Paste from Supabase → MyTable-dev → Project Settings
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Member auth (email OTP + Google) — BeSquare-style modal
# Supabase → Authentication → URL Configuration → Redirect URLs, add:
#   http://localhost:3001/auth/callback
#   https://www.mytable.club/auth/callback
#   https://mytable.club/auth/callback
#   http://localhost:3001/api/auth/callback
#   https://dashboard.mytable.club/api/auth/callback   (admin only)
# Enable providers: Email (OTP), Google

# Production DB source for db:sync-dev — copy .env.production.local.example
# DEV_SYNC_ON_START=false skips prod→dev sync on npm run dev

# Stripe (STOP 3 test, STOP 4 live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Clubmember prices are created automatically (lookup keys mytable_club_1m/6m).
# 3m remains in Stripe for existing subscribers only; not sold on the paywall.
# Enable Customer Portal in Stripe Dashboard for subscription cancel/update.
# Webhook events needed: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# Optional: Stripe coupon for referred friends (first month discount)
# STRIPE_REFERRAL_FRIEND_COUPON_ID=

# App
# Production MUST be https://www.mytable.club or https://mytable.club
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# NEXT_PUBLIC_SITE_URL=https://www.mytable.club
# Admin dashboard subdomain (staff only)
NEXT_PUBLIC_ADMIN_URL=https://dashboard.mytable.club
# Optional: force local OAuth origin if you keep production URLs above during dev
LOCAL_DEV_ORIGIN=http://localhost:3001
ADMIN_HOST=dashboard.mytable.club
USE_DB_EVENTS=true
NEXT_PUBLIC_USE_DB_EVENTS=true
# Must be @mytable.club addresses. Domain is always required; list is an extra allowlist.
ADMIN_EMAILS=you@mytable.club
MAX_SEATS_PER_ORDER=4
SHOW_VIEW_COUNT=false

# PostHog (EU) — https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_API_HOST=https://eu.posthog.com
# Optional: PostHog dashboard → Share → Embed
POSTHOG_DASHBOARD_EMBED_URL=
# Growth dashboard ID (default 729743) for admin link
POSTHOG_GROWTH_DASHBOARD_ID=729743

# Meta Pixel (Facebook / Instagram ads)
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API — Events Manager → Settings → Generate access token
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager → Test events — for staging verification only
# META_CAPI_TEST_EVENT_CODE=TEST12345

# Google Ads — Tools → Conversions → create purchase action → tag setup
# Conversion ID: AW-XXXXXXXXX | Label: alphanumeric string from send_to
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=MyTable <info@mytable.club>
EMAIL_REPLY_TO=info@mytable.club
# BCC booking confirmations (same email as customer). Default: info@mytable.club. Set empty to disable.
EMAIL_BCC=info@mytable.club

# Vercel Cron (Pro plan — hourly catch-up for missed confirmation emails)
# Generate: -join ((48..57 + 65..90 + 97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
CRON_SECRET=
